# =========================
# Large data folders
# =========================
data/raw/satellite_labels/**
data/raw/environment_terrain/**
data/aligned/**
data/aligned_compressed/**
data/tensors/**
models/**

# Keep folder structure
!data/**/.gitkeep
!models/.gitkeep

# =========================
# Allow small useful CSV/JSON metadata files
# =========================
!data/raw/csv/*.csv
!data/raw/csv/*.json
!data/aligned_compressed/*.csv
!data/aligned_compressed/*.json
!data/aligned/*.csv
!data/aligned/*.json
